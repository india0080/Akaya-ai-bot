# Copy to .env.local and fill in. Leave a value empty to disable that integration (nothing is injected).
VITE_SITE_URL=https://akaya.one
# Google Search Console HTML-tag verification (content="..." value only)
VITE_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification (msvalidate.01 content value)
VITE_BING_SITE_VERIFICATION=
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
VITE_GA4_ID=
# Google Tag Manager container id, e.g. GTM-XXXXXXX
VITE_GTM_ID=
# Microsoft Clarity project id (optional)
VITE_CLARITY_ID=
# IndexNow key (8-128 hex chars). Build writes /<key>.txt; `npm run indexnow` pings Bing/Yandex/etc.
INDEXNOW_KEY=
# Future backend (auth + content API). Empty = local stubs.
VITE_API_BASE_URL=
