# Akaya Grocery Agent: copy to .env (agent root or backend/). Every key is optional.
# With nothing set, all five stores run on the Mock provider (realistic SAMPLE prices, fees and ETAs).

PORT=8788
HOST=0.0.0.0
CORS_ORIGIN=*
DATA_FILE=data/db.json

# Which stores should use a real adapter instead of Mock (comma list).
# mock | instamart | blinkit | zepto | bigbasket | amazonfresh
PROVIDERS=mock

# Delivery address used for serviceability and ETAs (sample defaults; users can change it in Settings)
DEFAULT_PINCODE=560034
DEFAULT_ADDRESS=Koramangala, Bengaluru

# Engine
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=600
QUOTE_RATE_LIMIT_PER_MINUTE=60
QUEUE_CONCURRENCY=4
MOCK_LATENCY_MS=300
# How long a filled cart's prices are held before the user is asked to re-check
PAYMENT_WINDOW_MINUTES=15
SCHEDULE_TICK_MS=60000
# Mock order tracking speed (1 = real time; 20 = a 10-min delivery plays out in 30 s)
ORDER_SIM_SPEED=20
SEED_SAMPLE_LISTS=true

# ---------------------------------------------------------------------------------------------
# Playwright adapters: drive the USER'S OWN logged-in store session (see docs/PROVIDERS.md).
# Experimental, OFF by default, may break with site changes and may conflict with store terms.
# They only search and fill the cart. They never pay or place orders.
#   1. npm --prefix backend i -D playwright && npx playwright install chromium
#   2. log in once and save the session:  npx playwright codegen --save-storage=secrets/blinkit.json https://blinkit.com
#   3. set ENABLE_PLAYWRIGHT=true, PROVIDERS=mock,blinkit and the path below
ENABLE_PLAYWRIGHT=false
PLAYWRIGHT_HEADLESS=true
INSTAMART_STORAGE_STATE=
BLINKIT_STORAGE_STATE=
ZEPTO_STORAGE_STATE=
BIGBASKET_STORAGE_STATE=
AMAZON_FRESH_STORAGE_STATE=

# ---------------------------------------------------------------------------------------------
# Push notifications ("cart ready, confirm & pay"). In-app SSE works without keys.
# Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Firebase Cloud Messaging (Android / iOS apps)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Production: shared cache / queue
REDIS_URL=

# ---------------------------------------------------------------------------------------------
# Official store MCP servers (preferred partner route). Experimental skeleton (response mapping TODO).
# Token = the signed-in user's OAuth access token (OAuth 2.1 + PKCE, run by your app). Add the store to
# PROVIDERS, e.g. PROVIDERS=mock,instamart. Optional dep: npm --prefix backend i @modelcontextprotocol/sdk
# Akaya only calls search/cart tools; checkout and payment tools are blocked in code.
INSTAMART_MCP_URL=https://mcp.swiggy.com/im
INSTAMART_MCP_TOKEN=
ZEPTO_MCP_URL=https://mcp.zepto.co.in/mcp
ZEPTO_MCP_TOKEN=
