    "/api/checkouts": {
      "post": {
        "summary": "Fill store cart(s) for a plan (no payment)",
        "tags": [
          "checkout"
        ],
        "description": "Creates one cart per store and fills it via the provider. Notifies \"ready to pay\" when done. Never pays.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quoteId": {
                    "type": "string"
                  },
                  "planId": {
                    "type": "string"
                  },
                  "overrides": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "itemId": {
                          "type": "string"
                        },
                        "store": {
                          "type": "string",
                          "enum": [
                            "instamart",
                            "blinkit",
                            "zepto",
                            "bigbasket",
                            "amazonfresh"
                          ]
                        },
                        "skuId": {
                          "type": "string"
                        },
                        "packs": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 50
                        }
                      },
                      "required": [
                        "itemId",
                        "store",
                        "skuId",
                        "packs"
                      ]
                    }
                  },
                  "removed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "quoteId",
                  "planId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "get": {
        "summary": "Checkouts",
        "tags": [
