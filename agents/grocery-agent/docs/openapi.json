    "/api/parse": {
      "post": {
        "summary": "Parse a grocery list (EN / HI / Hinglish)",
        "tags": [
          "lists"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/quotes": {
      "post": {
        "summary": "Compare stores and build optimized baskets (job)",
        "tags": [
          "quotes"
        ],
        "description": "Send `text` or edited `items`. Stream progress at /api/jobs/{id}/events, or pass `wait: true`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "description": "free-text list, e.g. \"2 kg aata, 1 L Amul milk, 6 eggs\"",
                    "type": "string",
                    "maxLength": 2000
                  },
                  "items": {
                    "description": "already-parsed (and possibly edited) items",
                    "maxItems": 60,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "raw": {
                          "type": "string"
                        },
                        "key": {
                          "type": "string",
                          "description": "catalogue item key, e.g. \"atta\""
                        },
                        "name": {
                          "type": "string"
                        },
                        "emoji": {
                          "type": "string"
                        },
                        "qty": {
                          "type": "number",
                          "description": "in base units (g / ml / pc)"
                        },
                        "unit": {
                          "type": "string",
                          "enum": [
                            "g",
                            "ml",
                            "pc"
                          ]
                        },
                        "display": {
                          "type": "string",
                          "description": "human quantity, e.g. \"2 kg\""
                        },
                        "brand": {
                          "type": "string"
                        },
                        "variant": {
                          "description": "pack-name preference, e.g. \"Mustard\"",
                          "type": "string"
                        },
                        "confidence": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "id",
                        "raw",
                        "key",
                        "name",
                        "emoji",
                        "qty",
                        "unit",
                        "display",
                        "confidence"
                      ]
                    }
                  },
                  "pincode": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  },
                  "address": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "budget": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMinimum": true
                  },
                  "stores": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "instamart",
                        "blinkit",
                        "zepto",
                        "bigbasket",
                        "amazonfresh"
                      ]
                    }
                  },
                  "wait": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "running",
                        "done",
                        "failed"
                      ]
                    },
                    "progress": {
                      "type": "array",
                      "items": {}
                    },
                    "error": {
                      "type": "string"
                    },
                    "result": {}
                  },
                  "required": [
                    "id",
                    "type",
                    "status",
                    "progress"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "202": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "running",
                        "done",
                        "failed"
                      ]
                    },
                    "progress": {
                      "type": "array",
                      "items": {}
                    },
                    "error": {
                      "type": "string"
                    },
                    "result": {}
                  },
                  "required": [
                    "id",
                    "type",
                    "status",
                    "progress"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
