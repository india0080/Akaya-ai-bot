{
  "openapi": "3.0.3",
  "info": {
    "title": "Akaya Grocery Agent API",
    "version": "0.1.0",
    "description": "Parses grocery lists (English / Hindi / Hinglish), compares Swiggy Instamart, Blinkit, Zepto, BigBasket and Amazon Fresh, builds the cheapest / fastest / split basket, fills the cart and notifies the user to pay. **Never pays**: the user pays in the store app (UPI / card / OTP). Store providers run on Mock (SAMPLE data) until a Playwright session or partnership API is configured."
  },
  "components": {
    "schemas": {}
  },
  "paths": {
