{
  "openapi": "3.0.3",
  "info": {
    "title": "Akaya Shopping Agent API",
    "version": "0.1.0",
    "description": "Multi-store product search for India with ranking (price, rating, reviews, seller trust, delivery, fake-review signals), compare, price history, watchlist and price alerts. Runs on the Mock provider (SAMPLE data) until real provider keys are configured. The agent never checks out: \"Buy\" links open the store."
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/providers": {
      "get": {
        "summary": "Data providers and whether they are connected",
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/parse": {
      "post": {
        "summary": "Parse a natural-language query (EN / HI / Hinglish)",
        "tags": [
          "search"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "raw": {
                      "type": "string"
                    },
                    "q": {
                      "type": "string"
                    },
                    "filters": {
                      "type": "object",
                      "properties": {
                        "minPrice": {
                          "type": "number"
                        },
                        "maxPrice": {
                          "type": "number"
                        },
                        "minRating": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 5
                        },
                        "maxDeliveryDays": {
                          "type": "number"
                        },
                        "stores": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "amazon",
                              "flipkart",
                              "myntra",
                              "meesho",
                              "croma",
                              "ajio",
                              "reliance",
                              "tatacliq",
                              "nykaa",
                              "other"
                            ]
                          }
                        },
                        "hideHighFakeRisk": {
                          "type": "boolean"
                        },
                        "inStockOnly": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    },
                    "hints": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "lang": {
                      "type": "string",
                      "enum": [
                        "en",
                        "hi",
                        "hinglish"
                      ]
                    }
                  },
                  "required": [
                    "raw",
                    "q",
                    "filters",
                    "hints",
                    "lang"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "post": {
        "summary": "Start a multi-store search job",
        "tags": [
          "search"
        ],
        "description": "Returns a job. Poll GET /api/jobs/{id} or stream GET /api/jobs/{id}/events. With `wait: true` the response includes results.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "description": "Natural language, e.g. \"school bag under 1500\" or \"1500 se kam ka basta\""
                  },
                  "filters": {
                    "type": "object",
                    "properties": {
                      "minPrice": {
                        "type": "number"
                      },
                      "maxPrice": {
                        "type": "number"
                      },
                      "minRating": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      },
                      "maxDeliveryDays": {
                        "type": "number"
                      },
                      "stores": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "amazon",
                            "flipkart",
                            "myntra",
                            "meesho",
                            "croma",
                            "ajio",
                            "reliance",
                            "tatacliq",
                            "nykaa",
                            "other"
                          ]
                        }
                      },
                      "hideHighFakeRisk": {
                        "type": "boolean"
                      },
                      "inStockOnly": {
                        "type": "boolean"
                      }
                    }
                  },
                  "sort": {
                    "type": "string",
                    "enum": [
                      "relevance",
                      "price_asc",
                      "price_desc",
                      "rating",
                      "delivery",
                      "discount"
                    ]
                  },
                  "preset": {
                    "description": "Ranking weights preset",
                    "type": "string",
                    "enum": [
                      "balanced",
                      "cheapest",
                      "fastest",
                      "quality"
                    ]
                  },
                  "wait": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "running",
                        "done",
                        "failed"
                      ]
                    },
                    "progress": {
                      "type": "array",
                      "items": {}
                    },
                    "error": {
                      "type": "string"
                    },
                    "result": {
                      "description": "SearchResult when done"
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "status",
                    "progress"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "202": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "running",
                        "done",
                        "failed"
                      ]
                    },
                    "progress": {
                      "type": "array",
                      "items": {}
                    },
                    "error": {
                      "type": "string"
                    },
                    "result": {
                      "description": "SearchResult when done"
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "status",
                    "progress"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
