    "/api/compare": {
      "post": {
        "summary": "Side-by-side comparison of 2–4 products",
        "tags": [
          "products"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
