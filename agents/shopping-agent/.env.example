# Akaya Shopping Agent: copy to .env (agent root or backend/). Every key is optional.
# With no keys the agent uses the Mock provider: realistic SAMPLE data, clearly labelled in the UI/API.

PORT=8787
CORS_ORIGIN=*
# comma list of providers to try: mock, amazon, flipkart, serpapi, browser
# unconfigured providers are skipped; if none are configured the Mock provider is used
PROVIDERS=mock
CACHE_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=600
SEARCH_RATE_LIMIT_PER_MINUTE=60
QUEUE_CONCURRENCY=4
MOCK_LATENCY_MS=350
PRICE_CHECK_INTERVAL_MS=30000
DATA_FILE=data/db.json

# Amazon Associates: Creators API (PA-API 5.0 was retired 15 May 2026; old AWS keys don't work)
# Associates Central (amazon.in) → Tools → Creators API → Create application → Create credential
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
# India uses the EU token endpoint (credential version 3.2)
AMAZON_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token
AMAZON_MARKETPLACE=www.amazon.in

# Flipkart Affiliate API (affiliate.flipkart.com)
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# SerpApi: Google Shopping India (serpapi.com)
SERPAPI_KEY=

# Browser-agent fallback (Playwright). OFF by default: may violate store ToS and get blocked.
ENABLE_BROWSER_FALLBACK=false

# Notifications: Web Push (VAPID) / Firebase Cloud Messaging. Delivery is a stub until wired.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Optional Redis for cache + queue in production
REDIS_URL=

# Frontend (Vite): leave empty in dev (Vite proxies /api to the backend)
VITE_API_URL=
