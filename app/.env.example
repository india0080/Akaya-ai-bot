# Copy to .env.local (git-ignored). Leave the Firebase values empty to use the local Demo mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Optional: integrations / notes backend and agent URLs
VITE_INTEGRATIONS_PROVIDER=mock
VITE_AKAYA_API=
VITE_NOTES_PROVIDER=
VITE_SHOPPING_AGENT_URL=http://localhost:5174
VITE_GROCERY_AGENT_URL=http://localhost:5175
