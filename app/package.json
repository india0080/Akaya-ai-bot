{
  "name": "akaya-app",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "description": "Akaya: your intelligent assistant (mobile-first PWA prototype)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:standalone": "tsc -b && vite build --mode standalone",
    "preview": "vite preview",
    "lint": "eslint .",
    "logos": "node scripts/gen-logos.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc -b",
    "build:android": "tsc -b && vite build --mode android && npx cap sync android",
    "android:assets": "npx @capacitor/assets generate --android",
    "android:apk": "npm run build:android && cd android && ./gradlew assembleDebug",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "firebase": "^13.0.0",
    "framer-motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@iconify-json/cib": "^1.2.3",
    "@iconify-json/logos": "^1.2.15",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/thesvg": "^1.2.8",
    "@iconify-json/thesvg-color": "^1.2.15",
    "@iconify-json/vscode-icons": "^1.2.87",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "simple-icons": "^16.34.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
