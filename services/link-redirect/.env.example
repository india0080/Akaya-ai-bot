# Akaya link-redirect (copy to .env). Never commit real values.
PORT=8790
# public origin of short links (placeholder until DNS is set up)
PUBLIC_BASE_URL=https://go.akaya.one
# bearer token for POST /links, imports and reports (min 16 chars; generate with: openssl rand -hex 24)
ADMIN_TOKEN=
# secret for hashing anonymous install ids (min 16 chars; generate with: openssl rand -hex 24)
ANON_SALT=
# JSON store ("" = in memory). Production: Postgres (see README)
DATA_FILE=data/links.json

# --- Earnings API pulls (stubs; CSV upload works without these) ---
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
CUELINKS_API_KEY=
TRAVELPAYOUTS_API_TOKEN=
BOOKING_API_USERNAME=
BOOKING_API_PASSWORD=

# --- Affiliate IDs (all optional; empty = plain links with UTM only). See docs/AFFILIATE.md ---
