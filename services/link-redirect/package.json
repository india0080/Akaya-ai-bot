{
  "name": "@akaya/link-redirect",
  "version": "0.5.0",
  "private": true,
  "description": "Akaya short links (go.akaya.one): 302 to the affiliate URL with click logging, short-link API, earnings import adapters and a per-platform report.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@akaya/affiliate": "*",
    "@akaya/server-kit": "*",
    "fastify": "^5.12.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@akaya/config": "*",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
