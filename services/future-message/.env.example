# Copy to .env. Never commit real tokens.
PORT=8789
# Bearer token clients must send (Authorization: Bearer ...)
API_TOKEN=change-me
# memory (single process, dev) | bullmq (Redis)
QUEUE=memory
REDIS_URL=redis://localhost:6379
# mock = log only (default) | live = call the real channel APIs with the credentials below
SENDER_MODE=mock

# --- channel credentials for SENDER_MODE=live (dev convenience; production reads per-user OAuth tokens) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=akaya_scheduled_message
WHATSAPP_TEMPLATE_LANG=en
TELEGRAM_BOT_TOKEN=
GMAIL_ACCESS_TOKEN=
MS_GRAPH_ACCESS_TOKEN=
SLACK_BOT_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
X_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
YOUTUBE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
DISCORD_WEBHOOK_URL=
